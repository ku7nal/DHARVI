{
  "name": "depthwizard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:scene": "node --experimental-strip-types scripts/scene-layout-check.ts",
    "test:buildings": "node --experimental-strip-types scripts/building-geometry-check.ts",
    "test:terrain": "node --experimental-strip-types scripts/semantic-terrain-check.ts",
    "test:quality": "node --experimental-strip-types scripts/scene-quality-check.ts",
    "test:route": "node --experimental-strip-types scripts/route-mode-check.ts",
    "qa:presentation": "bash scripts/presentation-quality-check.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
